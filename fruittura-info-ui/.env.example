# SMTP Configuration for Contact Form
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_SECURE=true

# Contact Email Settings
CONTACT_TO=recipient@example.com
CONTACT_FROM="Your Name <sender@example.com>"

# NOTE: API_URL is currently hardcoded in lib/api.ts to "https://fruittura.onrender.com/api"
# If you wish to override it, you can modify lib/api.ts or refactor it to use NEXT_PUBLIC_API_URL.
